{
    "version": "0.4.11",
    "description": "Qoder Desktop - an agent workbench for human and AI software teams",
    "homepage": "https://qoder.com/download",
    "license": "Proprietary",
    "url": "https://download.qoder.com/qoder-app/releases/latest/Qoder-win-x64-user.exe",
    "hash": "784db56c2a3b566c337f0ea4c8191293677f74d6b5515432624f86e41da5b64b",
    "pre_install": [
        "# 1. 解压外层 NSIS 安装包",
        "$installer = Get-ChildItem $dir -Filter '*.exe' | Select-Object -First 1",
        "if ($installer) { Expand-7zipArchive $installer.FullName $dir -Removal }",
        "",
        "# 2. 提取内部 Electron 负载 ($PLUGINSDIR\\app-64.7z)",
        "$pluginDir = Get-ChildItem $dir -Directory -Force | Where-Object { $_.Name -match 'PLUGINSDIR' } | Select-Object -First 1",
        "if ($pluginDir) {",
        "    Get-ChildItem $pluginDir.FullName -Filter '*.7z' | ForEach-Object { Expand-7zipArchive $_.FullName $dir -Removal }",
        "}",
        "",
        "# 3. 清理 NSIS 遗留目录 ($PLUGINSDIR, $R0 等) 与卸载器图标",
        "Get-ChildItem $dir -Directory -Force | Where-Object { $_.Name -match '^\\$' } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\uninstallerIcon.ico\" -Force -ErrorAction SilentlyContinue"
    ],
    "post_install": [
        "# 生成 Windows Launcher 状态文件，缺失时启动会报 WINDOWS_LAUNCHER_STATE_MISSING",
        "$launcherDir = Join-Path $env:LOCALAPPDATA 'Qoder\\Qoder Launcher'",
        "if (-not (Test-Path $launcherDir)) { New-Item -ItemType Directory -Path $launcherDir -Force | Out-Null }",
        "$installDir = Join-Path (Split-Path $dir -Parent) 'current'",
        "$now = [DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ss.fffZ')",
        "$lines = @('[launcher]', 'schemaVersion=3', 'status=healthy', \"installDir=$installDir\", 'appExecutable=Qoder.exe', \"targetVersion=$version\", \"updatedAt=$now\")",
        "[System.IO.File]::WriteAllLines((Join-Path $launcherDir 'state.ini'), $lines, (New-Object System.Text.UTF8Encoding($false)))",
        "",
        "# 用户数据目录: %APPDATA%\\com.qoder.app.stable -> $persist_dir",
        "$folder = 'com.qoder.app.stable'",
        "$appDataPath = Join-Path $env:APPDATA $folder",
        "$scoopPersist = Join-Path $persist_dir $folder",
        "if (-not (Test-Path $scoopPersist)) { New-Item -ItemType Directory -Path $scoopPersist -Force | Out-Null }",
        "if (Test-Path $appDataPath) {",
        "    $item = Get-Item $appDataPath -Force",
        "    if ($item.Attributes -notmatch 'ReparsePoint') {",
        "        # 迁移已有的原生 Roaming 数据到持久化目录",
        "        Copy-Item -Path \"$appDataPath\\*\" -Destination $scoopPersist -Recurse -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $appDataPath -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "if (-not (Test-Path $appDataPath)) {",
        "    New-Item -ItemType Junction -Path $appDataPath -Target $scoopPersist -ErrorAction SilentlyContinue | Out-Null",
        "}",
        "",
        "# 写入数据目录映射记录，否则应用会拒绝已存在的 Junction",
        "$locFile = Join-Path $env:USERPROFILE '.qoder\\desktop\\storage\\stable\\location.v1.json'",
        "$locValid = $false",
        "if (Test-Path $locFile) {",
        "    try {",
        "        $loc = Get-Content $locFile -Raw -Encoding UTF8 | ConvertFrom-Json",
        "        $locValid = ($loc.directory -eq $scoopPersist) -and (Test-Path $loc.directory)",
        "    } catch {}",
        "}",
        "$linkedToPersist = $false",
        "if (Test-Path $appDataPath) {",
        "    $item = Get-Item $appDataPath -Force",
        "    if ($item.Attributes -match 'ReparsePoint') {",
        "        $target = @($item.Target)[0]",
        "        $linkedToPersist = $target -and ([System.IO.Path]::GetFullPath($target).TrimEnd('\\') -eq [System.IO.Path]::GetFullPath($scoopPersist).TrimEnd('\\'))",
        "    }",
        "}",
        "if (-not $locValid -and $linkedToPersist) {",
        "    $locDir = Split-Path $locFile -Parent",
        "    if (-not (Test-Path $locDir)) { New-Item -ItemType Directory -Path $locDir -Force | Out-Null }",
        "    $location = [ordered]@{ revision = 1; directory = $scoopPersist; activeRoots = @([ordered]@{ logicalPath = $appDataPath; targetPath = $scoopPersist }); transaction = $null } | ConvertTo-Json -Compress -Depth 5",
        "    [System.IO.File]::WriteAllText($locFile, $location, (New-Object System.Text.UTF8Encoding($false)))",
        "}"
    ],
    "pre_uninstall": [
        "$appDataPath = Join-Path $env:APPDATA 'com.qoder.app.stable'",
        "if (Test-Path $appDataPath) {",
        "    $item = Get-Item $appDataPath -Force",
        "    if ($item.Attributes -match 'ReparsePoint') { Remove-Item $appDataPath -Force -ErrorAction SilentlyContinue }",
        "}",
        "$locFile = Join-Path $env:USERPROFILE '.qoder\\desktop\\storage\\stable\\location.v1.json'",
        "$scoopPersist = Join-Path $persist_dir 'com.qoder.app.stable'",
        "if ((Test-Path $locFile) -and (Select-String -Path $locFile -Pattern $scoopPersist -SimpleMatch -Quiet -ErrorAction SilentlyContinue)) {",
        "    Remove-Item $locFile -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "shortcuts": [
        [
            "Qoder.exe",
            "Qoder Desktop"
        ]
    ],
    "persist": "com.qoder.app.stable",
    "checkver": {
        "url": "https://qoder.com/changelog",
        "regex": "tag_name.{1,10}(?<version>\\d+\\.\\d+\\.\\d+)(?:(?!tag_name).){1,800}?type.{1,10}app"
    },
    "autoupdate": {
        "url": "https://download.qoder.com/qoder-app/releases/$version/Qoder-win-x64-user.exe"
    }
}
