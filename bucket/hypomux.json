{
    "version": "2.5.9",
    "description": "CN Windows 多网卡聚合与网络加速工具。一键融合有线、Wi-Fi、热点等连接，实现多路径传输与智能流量调度。 EN Windows multi-NIC network accelerator. Combine Ethernet, Wi-Fi, hotspots and more for multi-path transmission and smart traffic routing.",
    "homepage": "https://hypomux.com",
    "license": "AGPL-3.0",
    "url": "https://github.com/Hypostasis-Cat/HypoMux/releases/download/v2.5.9/HypoMux_Setup_2.5.9.exe",
    "hash": "",
    "pre_install": [
        "$installer = Get-ChildItem $dir -Filter '*.exe' | Select-Object -First 1",
        "if ($installer) { Expand-7zipArchive $installer.FullName $dir -Removal }",
        "",
        "$pluginDir = Get-ChildItem $dir -Directory -Force | Where-Object { $_.Name -match 'PLUGINSDIR|_OUTDIR' } | Select-Object -First 1",
        "if ($pluginDir) {",
        "    $archive = Get-ChildItem $pluginDir.FullName -Filter '*.7z' -ErrorAction SilentlyContinue | Select-Object -First 1",
        "    if ($archive) { Expand-7zipArchive $archive.FullName $dir -Removal }",
        "}",
        "",
        "if (Test-Path \"$dir\\{app}\") {",
        "    Get-ChildItem \"$dir\\{app}\" -Force | Move-Item -Destination $dir -Force",
        "    Remove-Item \"$dir\\{app}\" -Recurse -Force",
        "}",
        "",
        "Get-ChildItem $dir -Directory -Force | Where-Object { $_.Name -match '^\\$' } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue",
        "Get-ChildItem $dir -Filter 'uninst*.exe' -Recurse -ErrorAction SilentlyContinue | Remove-Item -Force",
        "Get-ChildItem $dir -Filter 'uninstall*.exe' -Recurse -ErrorAction SilentlyContinue | Remove-Item -Force"
    ],
    "shortcuts": [
        [
            "HypoMux.exe",
            "HypoMux"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Hypostasis-Cat/HypoMux"
    },
    "autoupdate": {
        "url": "https://github.com/Hypostasis-Cat/HypoMux/releases/download/v$version/HypoMux_Setup_$version.exe"
    }
}
