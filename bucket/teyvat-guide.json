    "pre_install": [
        "# 通用大扫除：清理快捷方式和卸载程序残留",
        "Get-ChildItem $dir -Filter '*.lnk' -Recurse -ErrorAction SilentlyContinue | Remove-Item -Force",
        "Get-ChildItem $dir -Filter 'Uninstall*' -Recurse -ErrorAction SilentlyContinue | Remove-Item -Force",
        "# 清理可能残留的空壳目录",
        "Get-ChildItem $dir -Directory -Force -ErrorAction SilentlyContinue | Where-Object { $_.GetFileSystemInfos().Count -eq 0 } | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "TeyvatGuide.exe",
            "Teyvat Guide"
        ]
    ],
