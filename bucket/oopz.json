{
    "version": "1.4.5",
    "description": "Oopz application",
    "homepage": "https://www.oopz.cn/",
    "license": "Unknown",
    "url": "https://downloadcdn.oopz.cn/release/145/oopz_setup_v1.4.5.exe",
    "hash": "69e648d9e795ccf2c297936b06cf29cfdf73e9adcbb868b4afcd4055b05a6610",
    "pre_install": [
        "$installer = Get-ChildItem $dir -Filter '*.exe' | Select-Object -First 1",
        "if ($installer) { Expand-7zipArchive $installer.FullName $dir -Removal }",
        "",
        "$archives = Get-ChildItem $dir -Filter '*.7z' -Recurse -ErrorAction SilentlyContinue",
        "foreach ($archive in $archives) {",
        "    Expand-7zipArchive $archive.FullName $dir -Removal -ErrorAction SilentlyContinue",
        "}",
        "",
        "Get-ChildItem $dir -Directory -Force | Where-Object { $_.Name -match '^\\$|^uninstaller$' } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\oopz_installer.tar\" -Force -ErrorAction SilentlyContinue"
    ],
    "post_install": [
        "$folders = @('oopz', 'oopz.cn')",
        "foreach ($folder in $folders) {",
        "    $appDataPath = Join-Path $env:APPDATA $folder",
        "    $scoopPersist = Join-Path $persist_dir $folder",
        "    if (-not (Test-Path $scoopPersist)) { New-Item -ItemType Directory -Path $scoopPersist -Force | Out-Null }",
        "",
        "    if (Test-Path $appDataPath) {",
        "        $item = Get-Item $appDataPath -Force",
        "        if ($item.Attributes -notmatch 'ReparsePoint') {",
        "            # 直接复制原生 Roaming 数据到持久化目录",
        "            Copy-Item -Path \"$appDataPath\\*\" -Destination $scoopPersist -Recurse -Force -ErrorAction SilentlyContinue",
        "            # 删除原目录，为建立虫洞腾出位置",
        "            Remove-Item $appDataPath -Force -Recurse -ErrorAction SilentlyContinue",
        "        } else {",
        "            Remove-Item $appDataPath -Force -ErrorAction SilentlyContinue",
        "        }",
        "    }",
        "    # 建立虫洞链接",
        "    New-Item -ItemType Junction -Path $appDataPath -Target $scoopPersist | Out-Null",
        "}"
    ],
    "pre_uninstall": [
        "$folders = @('oopz', 'oopz.cn')",
        "foreach ($folder in $folders) {",
        "    $appDataPath = Join-Path $env:APPDATA $folder",
        "    if (Test-Path $appDataPath) {",
        "        $item = Get-Item $appDataPath -Force",
        "        if ($item.Attributes -match 'ReparsePoint') { Remove-Item $appDataPath -Force -ErrorAction SilentlyContinue }",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "oopz.exe",
            "Oopz"
        ]
    ],
    "persist": [
        "sandbox",
        "oopz",
        "oopz.cn"
    ],
    "checkver": {
        "script": [
            "$url = 'https://www.oopz.cn/download/xx'",
            "try {",
            "    $req = [System.Net.WebRequest]::Create($url)",
            "    $req.AllowAutoRedirect = $false",
            "    $req.UserAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'",
            "    $res = $req.GetResponse()",
            "    $loc = $res.Headers['Location']",
            "    $res.Close()",
            "    Write-Output $loc",
            "} catch {",
            "    Write-Output 'https://downloadcdn.oopz.cn/release/0/oopz_setup_v0.0.0.exe'",
            "}"
        ],
        "regex": "release/(?<build>\\d+)/oopz_setup_v(?<version>[\\d.]+)\\.exe"
    },
    "autoupdate": {
        "url": "https://downloadcdn.oopz.cn/release/$matchBuild/oopz_setup_v$version.exe"
    }
}
