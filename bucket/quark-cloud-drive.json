    "innosetup": true,
    "installer": {
        "script": [
            "Move-Item -LiteralPath \"$dir\\{code_GetAppExeDestName}\" -Destination \"$dir\\quark_cloud_drive.exe\"",
            "Move-Item -LiteralPath \"$dir\\{code_GetAppProxyExeDestName}\" -Destination \"$dir\\quark_cloud_drive_proxy.exe\"",
            "Move-Item -LiteralPath \"$dir\\components\\clouddrive_desktop_widget_independent\\{code_GetAppWidgetExeName}\" -Destination \"$dir\\components\\clouddrive_desktop_widget_independent\\clouddrive_desktop_widget_independent.exe\""
