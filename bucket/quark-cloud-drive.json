    "script": [
      "$req = [System.Net.WebRequest]::Create('https://download.quark.cn/download/quarkclouddrivepc?platform=pc&ch=pckk@product_guanwang')",
      "$req.Method = 'HEAD'",
      "$req.AllowAutoRedirect = $false",
