    "hash": "3f42d7679fbc484120fad66b09e277948f8318c630e578452d7e1f9fbee0cbae",
    "bin": [
        [
            "IPATool GUI.exe",
            "ipatool-gui"
        ]
    ],
    "shortcuts": [
        [
            "IPATool GUI.exe",
            "IPATool GUI"
        ]
    ],
    "pre_install": [
        "# ipatool-gui 的 win 包是 NSIS 外壳包裹的便携程序：解包内嵌的 app-64.7z 还原便携目录",
        "$exe = Get-ChildItem \"$dir\" -Filter '*.exe' | Select-Object -First 1",
        "Expand-7zipArchive $exe.FullName \"$dir\\_nsis\"",
        "$inner = Join-Path \"$dir\\_nsis\" '$PLUGINSDIR\\app-64.7z'",
        "Expand-7zipArchive $inner \"$dir\" -Removal",
        "Remove-Item \"$dir\\_nsis\" -Recurse -Force",
        "Remove-Item $exe.FullName -Force"
    ],
    "checkver": {
        "github": "https://github.com/a23bc/ipatool-gui"
    },
    "autoupdate": {
        "url": "https://github.com/a23bc/ipatool-gui/releases/download/v$version/ipatool-gui-$version-win-x64-portable.exe"
    }
}
